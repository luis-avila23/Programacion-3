<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SIVAN - Iniciar Sesión</title>
    <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body class="login-page">

    <div class="card login-card">
        <div class="login-card-header">
            <img src="/assets/image/SIVAN-LOGO.png" alt="logo de SIVAN" class="logo-web">
            <h2>SIVAN</h2>
            <p class="section-desc">Sistema Nacional de Vacunación</p>
        </div>

        <% if (mensaje) { %>
            <p class="section-desc"><%= mensaje %></p>
        <% } %>

        <form method="post" action="/login/envio">
            <div class="form-group">
                <label for="username">Correo o Usuario Institucional</label>
                <input type="text" id="username" name="login" placeholder="Ej: master@sivan.gob.ve" required>
            </div>

            <div class="form-group">
                <label for="password">Contraseña</label>
                <input type="password" id="password" name="password" placeholder="Contraseña" required>
            </div>

            <button type="submit" class="btn btn-primary btn-full">Iniciar Sesión</button>
        </form>

        <div class="login-hints">
            <p>Credenciales de prueba:</p>
            <ul>
                <li><strong>Master:</strong> master@sivan.gob.ve</li>
                <li><strong>Subregión:</strong> subregion@sivan.gob.ve</li>
                <li><strong>Vacunador:</strong> vacunador@sivan.gob.ve</li>
                <li><strong>Contraseña:</strong> sivan123</li>
            </ul>
        </div>

        <div class="login-footer-link">
            <a href="/consulta">¿Eres ciudadano? Consulta tu carnet aquí &rarr;</a>
        </div>
    </div>
</body>
</html>
